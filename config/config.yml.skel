%YAML 1.2
---

label: "Yor project name"
ui_update_interval: 35  # seconds

graph_file: root.mermaid
database_uri: valkey://valkey:6379/0
defaults:
  update_interval: 60  # in seconds
  levels:
    normal: null  # if normal defined, then any other value is danger
    warning: 'value >= 90'
    danger: 'value >= 95'
    measurement: '%'
notifications:
  delay: 60  # in seconds
  recipients:
    - smtp://login:pasword@stmp.server:port?from=noreply@foo.com&to=user@foo.com
    - shell://sent-to-telegram.sh

providers:
  my-prometeus:
    type: prometeus
    base_url: https://stat-server.foo/prometheus/api/v1/query
    metrics:
      server-ready:
        query: 'up{project="my-proj"}'
        normal_level: 1
      server-tempherature:
        query: 'node_thermal_zone_temp{project="my-proj"}'
        warning_level: 70
        danger_level: 80
        measurement: '°C'
      disk-free:
        query: 'round(node_filesystem_avail_bytes{project="my-proj", fstype!~"tmpfs|fuse.lxcfs", mountpoint!~"(/boot|/boot/.*|/tmp/.*)"} /1024/1024)'
        level_direction: 'down'
        warning_level: 2048
        danger_level: 1024
        measurement: 'MB'
      memory-free:
        query: 'round(node_memory_MemAvailable_bytes{project="my-proj"} /1024/1024)'
        level_direction: 'down'
        warning_level: 1024
        danger_level: 512
        measurement: 'MB'
      oom-count:
        query: 'increase(node_vmstat_oom_kill{project="my-proj"}[1h]) > 0'
        levels:
          warning: 'value > 0'
          danger: 'value > 2'
      cpu-busy:
        query: 'sum by (location, name, instance) (node_load5{project="my-proj"}) / count by (location, name, instance) (node_cpu_seconds_total{project="my-proj", mode="idle"}) * 100'
        warning_level: 90
        danger_level: 100
      # docker-services:

nodes:
  app-server:
    label: "App server"
    graph_file: app-server.mermaid
    child_nodes:
      app-server-cpu-busy:
        metric_source: shell://top -bn1 | grep "CPU:" | head -n 1 | sed "s/% idle //g" | awk '{ print 100 - $8 }'
        # for debian: top -bn1 | grep "Cpu(s)" | sed "s/id,//g" | awk '{print 100-$8}'
      app-server-memory:
        metric_source: shell://free | awk '/^Mem:/ {print int($3/$2 * 100)}'
      app-server-disk-free:
        metric_source: shell://df -mT | sed 1d | grep -v -E '\s(tmpfs|devtmpfs|overlay|rootfs)\s' | awk '{print $7, $5}'
        metric_mask_re: '^(?P<name>[^\s]+)\s+(?P<value>[^\s]+)'
        levels:
          warning: 'value <= 2048'
          danger: 'value <= 1024'
          measurement: 'MB'
      app-server-oom:
        metric_source: shell://[ -f /var/log/syslog ] && awk -v cutoff="$(date -d "-1 hour" "+%s")" -v os_start_ts="$(date -d "$(who -b|awk '{print $3,$4}')" "+%s")" 'os_start_ts+substr($0, 1, 15) >= cutoff' /mnt/host_syslog | grep -i "oom-killer" | wc -l || echo -1
        levels:
          warning: 'value > 0 or value < 0'
          danger: 'value > 1'

  app-valkey:
    label: "App database"
    metric_source: shell://nc -z valkey 6379
    value_source: exit-code
    levels:
      normal: 'value == 0'

  app-cron:
    label: "App cron"
    metric_source: shell://[ -S /mnt/host_docker.sock ] && [ -w /mnt/host_docker.sock ] && curl -s --unix-socket /mnt/host_docker.sock "http://localhost/containers/json" | jq '.[].Names' -c | grep "mongraph-cron" | wc -l || echo -1
    levels:
      normal: 'value == "1"'

  internet:
    label: "Internet"
    metric_source: https://google.com/
    value_source: http-code
    levels:
      normal: 'value == 200'
